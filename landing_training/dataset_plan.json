{
  "schema": "aerodock.landing.collection.v1",
  "policy_hz": 25,
  "image_width": 640,
  "image_height": 360,
  "episode_duration_max_s": 180,
  "initial_episodes": 1200,
  "pilot_episodes": 60,
  "splits": {"training": 960, "validation": 120, "test": 120},
  "map_families": ["island", "beach", "city", "gravel", "rock"],
  "distance_bands_m": [[0, 5], [5, 20], [20, 60]],

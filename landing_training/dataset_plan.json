  "boat_speed_m_s": [0, 1],
  "wave_height_parameter_m": [0, 0.15],
  "wave_period_s": [2, 5],
  "wind_profiles": ["calm", "steady2", "breeze", "gusty"],
  "dock": {"lids_always_open": true, "platform_always_raised": true},
  "training": {"sequence_steps": 64, "effective_batch_sequences": 8, "learning_rate": 0.0001, "gru_hidden": 128},
  "hardware_pending": ["live camera latency", "gimbal interface", "radio interoperability and timing", "physical calibration"]
}

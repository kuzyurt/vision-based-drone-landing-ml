/.cloud-attachments/

# Raw experiment evidence: keep code and notes, not media/replays.
/artifacts/**
!/artifacts/
!/artifacts/**/
!/artifacts/**/*.py
!/artifacts/**/*.md

# Training runs: keep scripts and small run metadata, not frames/checkpoints.
/training_runs/**
!/training_runs/
!/training_runs/**/
!/training_runs/**/*.py
!/training_runs/**/*.md
!/training_runs/**/*.txt
!/training_runs/**/run.json
!/training_runs/**/summary.json
!/training_runs/**/RESULTS.md
!/training_runs/training_data_generation/rules/*.json

# Archived pre-V2 benchmark raw outputs; active benchmark has its own ignore rules.
/old/benchmark/runs/
/old/benchmark/probes/
/old/benchmark/audits/
/old/benchmark/models/
/old/benchmark/_superseded_inventory/
/old/benchmark/revisions/*/runs/
/old/benchmark/revisions/*/audits/
/old/benchmark/revisions/*/operations/


# Future generated data root: keep README, manifests, metadata and generator
# scripts; ignore the image/archive payloads.
/data/generated/**
!/data/generated/
!/data/generated/**/
!/data/generated/**/*.json
!/data/generated/**/*.md
!/data/generated/**/*.py

# Tidewater local build/runtime output
